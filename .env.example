NODE_ENV=development
PORT=5000
DATABASE_URL=postgres://eudyaan:eudyaan@localhost:5432/eudyaan
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SYNC=true
DB_SYNC_ALTER=false
DB_LOGGING=false
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1h
JWT_ISSUER=eudyaan-api
JWT_AUDIENCE=eudyaan-mobile
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY_HOPS=0
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=12000
PYTHON_BIN=python3
CLASSIFIER_TIMEOUT_MS=10000
CRISIS_SUPPORT_MESSAGE=If you may be in immediate danger, contact local emergency services or a trusted person near you now.
CRISIS_PHONE=
